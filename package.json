{
  "name": "ttrpg-helper",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "dev:gm": "pnpm --filter @ttrpg-helper/gm tauri dev",
    "dev:player": "pnpm --filter @ttrpg-helper/player tauri dev",
    "lint": "scripts/check.sh lint",
    "typecheck": "scripts/check.sh typecheck",
    "architecture": "scripts/check.sh architecture",
    "test": "vitest run",
    "check": "scripts/check.sh task"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "^9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
